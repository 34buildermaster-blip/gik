APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
APP_DISPLAY_TIMEZONE=Asia/Bangkok
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_RESET_EXPIRE=15

# Optional bootstrap accounts. Keep disabled after the first controlled provision.
SEED_STAFF_ACCOUNTS=false
SEED_ADMIN_USERNAME=Admin34
SEED_ADMIN_NAME=Admin34
SEED_ADMIN_EMAIL=admin34@34buildmaster.local
SEED_ADMIN_PASSWORD=
SEED_INSPECTOR_USERNAME=Inspector01
SEED_INSPECTOR_NAME="ผู้ตรวจหน้างาน 01"
SEED_INSPECTOR_EMAIL=inspector01@34buildmaster.local
SEED_INSPECTOR_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Uploaded media storage
# Keep "local" until Google Drive credentials and the destination folder are ready.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DISK=local
MEDIA_IMAGE_OPTIMIZE=true
MEDIA_IMAGE_QUALITY=82
MEDIA_IMAGE_MAX_WIDTH=2560
MEDIA_IMAGE_MAX_HEIGHT=2560

# Google Drive: service_account (recommended with a Workspace Shared Drive) or oauth.
GOOGLE_DRIVE_AUTH=service_account
GOOGLE_DRIVE_CREDENTIALS_PATH=storage/app/google/credentials.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CHUNK_SIZE=8388608

# Upload security. Enable on production after installing ClamAV on the VPS.
SECURITY_STAFF_2FA_REQUIRED=true
SECURITY_UPLOAD_SCAN_ENABLED=false
SECURITY_UPLOAD_SCAN_REQUIRED=false
SECURITY_UPLOAD_SCAN_FAIL_CLOSED=true
SECURITY_REQUIRE_CLEAN_FILES=false
SECURITY_CLAMAV_BINARY=clamscan
SECURITY_CLAMAV_TIMEOUT=120
SECURITY_QUARANTINE_DISK=local
SECURITY_QUARANTINE_PATH=quarantine
SECURITY_HSTS_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PROJECT_EMAIL_NOTIFICATIONS=false
PROJECT_LINE_NOTIFICATIONS=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_PUSH_URL=https://api.line.me/v2/bot/message/push

# Legal document version recorded when a customer registers.
LEGAL_POLICY_VERSION=2026-08-05
LEGAL_PRIVACY_EMAIL=34buildmaster@gmail.com
