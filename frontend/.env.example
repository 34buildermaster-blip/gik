# Leave empty when the browser and API use the same public domain.
# When set, use the Laravel origin only; application code appends /api itself.
NEXT_PUBLIC_API_URL=

# Required in production for canonical URLs, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# Internal Laravel HTTP origin used by Next.js rewrites and server rendering.
BACKEND_URL=http://127.0.0.1:8000
